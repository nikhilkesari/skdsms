<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.skedsms">

    <!-- 1. Core SMS Transmission: Dispatches single and multipart SMS messages -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- 2. Phone State: Determines active SIM subscription ID and carrier state on multi-SIM devices -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- 3. Contact Selection: Opens native device contact picker and retrieves recipient phone numbers -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- 4. Exact Alarm Scheduling: Required on Android 12 (API 31) for AlarmManager exact triggers -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 5. Use Exact Alarm: Required on Android 13+ (API 33+) for automatic exact alarm grant for schedulers -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 6. Boot Persistence: Receives BOOT_COMPLETED broadcast to restore pending alarms after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 7. Wake Lock: Prevents CPU sleep while processing alarm trigger and handing off to SmsManager -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 8. Notifications: Required on Android 13+ (API 33+) for status bar SMS delivery confirmations -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">

        <!-- Main Launcher Activity hosting React Native UI -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Background Alarm Receiver triggered by AlarmManager.RTC_WAKEUP -->
        <receiver
            android:name=".SmsAlarmReceiver"
            android:exported="false" />

        <!-- Device Reboot Receiver to re-arm pending schedules upon device power-on -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
